# =================================================================
# WordPress FrankenPHP - Environment Variables (.env)
# =================================================================

# -----------------------------------------------------------------
# 1. Database Configuration (Shared MySQL / MariaDB Server)
# -----------------------------------------------------------------
# Nama host database shared Anda:
# - Di Coolify jika satu server: gunakan nama container MySQL atau UUID service di network coolify (contoh: mariadb, mysql, atau 10.0.x.x)
# - Jika MySQL berjalan di host server: host.docker.internal:3306 atau 172.17.0.1:3306
DB_HOST=mysql:3306
DB_NAME=wordpress
DB_USER=wordpress_user
DB_PASSWORD=your_strong_db_password
DB_CHARSET=utf8mb4
DB_COLLATE=
TABLE_PREFIX=wp_

# -----------------------------------------------------------------
# 2. Redis Object Cache (Shared Redis Server)
# -----------------------------------------------------------------
# Jika menggunakan container Redis shared di server / Coolify:
WP_REDIS_HOST=redis
WP_REDIS_PORT=6379
# Password Redis (kosongkan jika Redis tidak dipassword)
WP_REDIS_PASSWORD=

# PENTING UNTUK SHARED REDIS:
# Pilih nomor database index (0-15) agar terpisah per website (misal: website 1 = 0, website 2 = 1)
WP_REDIS_DATABASE=0

# Prefix cache: Secara otomatis menggunakan nilai DB_NAME_ jika dikosongkan,
# sehingga cache antar website TIDAK AKAN BENTROK meskipun memakai database Redis yang sama!
WP_REDIS_PREFIX=wp_site1_

# -----------------------------------------------------------------
# 3. Site URLs & Reverse Proxy (Coolify)
# -----------------------------------------------------------------
# Di Coolify, jika dikosongkan, WP_HOME & WP_SITEURL otomatis terdeteksi
# dari domain yang diatur di Coolify Reverse Proxy (HTTPS).
# Jika ingin memaksakan domain tertentu, hilangkan tanda pagar (#):
# WP_HOME=https://your-domain.com
# WP_SITEURL=https://your-domain.com

# -----------------------------------------------------------------
# 4. Security Keys and Salts
# -----------------------------------------------------------------
# Anda bisa membuat keys acak di https://api.wordpress.org/secret-key/1.1/salt/
# Jika dikosongkan, sistem otomatis membuat salt aman yang konsisten.
AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=

# -----------------------------------------------------------------
# 5. Debugging & Environment Mode
# -----------------------------------------------------------------
WP_DEBUG=false
WP_DEBUG_LOG=false
WP_DEBUG_DISPLAY=false
SCRIPT_DEBUG=false
SAVEQUERIES=false

# -----------------------------------------------------------------
# 6. WordPress Performance & Limits
# -----------------------------------------------------------------
WP_MEMORY_LIMIT=256M
WP_MAX_MEMORY_LIMIT=512M
AUTOSAVE_INTERVAL=120
WP_POST_REVISIONS=5
EMPTY_TRASH_DAYS=30
DISALLOW_FILE_EDIT=true
# -----------------------------------------------------------------
# 7. WordPress Updates & Downloads Configuration
# -----------------------------------------------------------------
# FS_METHOD direct memastikan download plugin/theme tidak meminta FTP
FS_METHOD=direct
# Kontrol update core otomatis: 'minor' (keamanan saja), true (semua update), false (matikan)
WP_AUTO_UPDATE_CORE=minor
AUTOMATIC_UPDATER_DISABLED=false
